# Copy to .env on the Ubuntu host. Keep .env private; never commit credentials.
# Set to the browser-visible origin, with no trailing slash.
PUBLIC_FRONTEND_URL=http://localhost:5173
BIND_ADDRESS=0.0.0.0
FRONTEND_PORT=5173
ASSISTANT_PORT=8000
CATALOG_PORT=8080
IMAGE_TAG=local

# REQUIRED for live catalog access. Compose refuses to start if either is blank.
EKT_API_BASE_URL=https://ekt.kz
EKT_API_USERNAME=
EKT_API_PASSWORD=
CATALOG_MAX_PRODUCTS=100
CATALOG_CACHE_TTL_SECONDS=60
CATALOG_LOAD_TIMEOUT_MS=25000
ASSISTANT_CATALOG_TIMEOUT_SECONDS=30

# Optional catalog AI features. Set key and model before enabling.
OPENAI_PREVALIDATION_ENABLED=false
OPENAI_SEARCH_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TIMEOUT_MS=20000
OPENAI_MAX_OUTPUT_TOKENS=2048

# Optional assistant model; set both values to enable.
ASSISTANT_MODEL_API_KEY=
ASSISTANT_MODEL_NAME=
# Optional backend-only bootstrap secret. Account registration/login works without it.
ASSISTANT_BOOTSTRAP_TOKEN=
ASSISTANT_AUTH_TOKEN_TTL_SECONDS=86400
ASSISTANT_USER_HISTORY_TTL_DAYS=30
# Additional trusted certificate origins, comma separated; requires frontend rebuild.
VITE_CERTIFICATE_ORIGINS=
