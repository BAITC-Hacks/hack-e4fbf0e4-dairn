ASSISTANT_PORT=8000
ASSISTANT_ENVIRONMENT=development
ASSISTANT_ALLOW_DEMO_SESSIONS=true
ASSISTANT_BOOTSTRAP_TOKEN=
ASSISTANT_CATALOG_MODE=demo
ASSISTANT_CATALOG_BASE_URL=http://catalog-service:8000
ASSISTANT_CATALOG_SERVICE_TOKEN=
ASSISTANT_CATALOG_TIMEOUT_SECONDS=3
# Development/test only: synthetic responses on connection failure, never HTTP errors.
ASSISTANT_CATALOG_MOCK_ON_UNAVAILABLE=false
ASSISTANT_CART_MODE=demo
ASSISTANT_FRONTEND_BASE_URL=http://localhost:5173
ASSISTANT_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
# Optional; set BOTH to enable one model call per answer. No key required for templates.
ASSISTANT_MODEL_API_KEY=
ASSISTANT_MODEL_NAME=
# Local process only; Compose sets /data for both services.
ASSISTANT_DATA_DIR=./data

ASSISTANT_AUTH_TOKEN_TTL_SECONDS=86400
ASSISTANT_USER_HISTORY_TTL_DAYS=30
